# ==================================================================
# 环境变量 / 密钥（模板）
#
#   cp .env.example .env     然后编辑 .env 填入真实值
#
# * .env 已写进 .gitignore，不会被提交到 git。不要把 .env 发给任何人、不要截图。
# * 格式：KEY=VALUE，等号两边不要有空格；值里有空格或特殊字符时用单引号括起来。
# * 以 FREQTRADE__ 开头的变量会覆盖配置文件里的同名字段（freqtrade 官方机制，
#   两个下划线 __ 表示层级，例如 FREQTRADE__EXCHANGE__KEY = 配置里的 exchange.key）。
# * 读取 .env 的地方：docker compose 的 ui / freqtrade 服务、scripts/run_bot.sh、
#   scripts/test_notify.py。回测和下载数据不需要 .env。
# ==================================================================

# ---------------- 策略 ----------------
# 机器人要跑的策略【类名】（不是文件名），例如 MyTrendStrategy
FREQTRADE__STRATEGY=

# ---------------- 模拟盘 / 实盘 ----------------
# true  = 模拟盘 dry-run（默认，不会真下单，模拟资金 1000 USDT）
# false = 实盘（真钱！先完成 README 里的「上实盘前检查清单」）
# 只写小写的 true 或 false。注意 freqtrade 不分大小写：False、FALSE 也会被当成实盘；
# 写成 0 / 1 / no / 留空等其他值，启动检查（scripts/preflight.sh）会拒绝启动。
FREQTRADE__DRY_RUN=true

# ---------------- 币安 API Key（只有实盘才需要）----------------
# 在币安创建 API Key 时：
#   - 只开启「允许合约」（Enable Futures），【不要】开启「允许提现」
#   - 开启「限制 IP 访问」，只填你服务器的公网 IP
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# ---------------- FreqUI 网页 / REST API 登录 ----------------
# 用户名、密码自己定（密码至少 10 位）
FREQTRADE__API_SERVER__USERNAME=
FREQTRADE__API_SERVER__PASSWORD=
# 下面两个填随机字符串，用这条命令生成（每个各运行一次）：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=

# ---------------- Telegram ----------------
# Bot token：在 Telegram 里找 @BotFather，发 /newbot 创建机器人后得到，形如 123456789:AAH...
FREQTRADE__TELEGRAM__TOKEN=
# Chat id：先给你的机器人发一条消息，再打开
#   https://api.telegram.org/bot<你的token>/getUpdates
# 找到 "chat":{"id": 数字}，那个数字就是 chat id（群组是负数，要带上负号）
FREQTRADE__TELEGRAM__CHAT_ID=

# 中文交易通知（开仓/平仓/撤单/状态/强平预警…，模板在 configs/config.notify-zh.json）
FREQTRADE__WEBHOOK__ENABLED=false
# freqtrade 自带的 Telegram 命令机器人（/status /profit /balance /stop …，回复是英文）
# 它自己的交易通知已在配置里关掉，避免和中文通知重复
FREQTRADE__TELEGRAM__ENABLED=false
