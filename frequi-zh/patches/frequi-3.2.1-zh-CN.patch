diff --git a/scripts/check-i18n.mjs b/scripts/check-i18n.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..36718ba518a1a165a720edb05d02cfbff39bb8c8
--- /dev/null
+++ b/scripts/check-i18n.mjs
@@ -0,0 +1,362 @@
+#!/usr/bin/env node
+/**
+ * FreqUI i18n consistency check (zh-CN localization patch).
+ *
+ * Usage:  node scripts/check-i18n.mjs [--strict] [--quiet] [--root <frequi checkout>]
+ *
+ * Errors (exit code 1):
+ *   - a locale JSON file does not parse
+ *   - group files differ between locales
+ *   - en / zh-CN key sets differ (per group)
+ *   - empty / non-string messages, placeholder mismatch, unescaped @ { } |
+ *   - a key used in src/ (t('a.b'), $t, te, keypath="a.b") does not exist in en
+ *   - a key in en is never used in src/ (unused key). Keys of the shared vocabulary group
+ *     `common` are exempt; they are only counted.
+ *
+ * Warnings (exit code 0, or 1 with --strict):
+ *   - likely user-visible English text left in .vue templates
+ *     (text nodes, static UI attributes, string literals in bound UI attributes)
+ *   - likely user-visible English literals in script code (label:/title:/showAlert(...))
+ *   - hard-coded Chinese text outside src/locales
+ *
+ * The heuristics have an allow list (ALLOWED_TEXT) for brand names, abbreviations and
+ * values that come from the bot. Extend it when a warning is intentional, or put a
+ * `// i18n-ignore: <reason>` comment on the script line.
+ */
+import fs from 'node:fs';
+import path from 'node:path';
+import process from 'node:process';
+import { fileURLToPath } from 'node:url';
+import { parse as parseSfc } from '@vue/compiler-sfc';
+
+const argv = process.argv.slice(2);
+const rootArg = argv.indexOf('--root');
+const root =
+  rootArg >= 0 && argv[rootArg + 1]
+    ? path.resolve(argv[rootArg + 1])
+    : path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const srcDir = path.join(root, 'src');
+const localeDir = path.join(srcDir, 'locales');
+const LOCALES = ['en', 'zh-CN'];
+const REFERENCE = 'en';
+const args = new Set(argv);
+/** Groups that hold shared vocabulary on purpose; their unused keys are not an error. */
+const VOCABULARY_GROUPS = ['common'];
+const strict = args.has('--strict');
+const quiet = args.has('--quiet');
+
+const errors = [];
+const warnings = [];
+
+// ---------------------------------------------------------------- locale files
+function flatten(tree, prefix = '', out = {}) {
+  for (const [k, v] of Object.entries(tree)) {
+    const key = prefix ? `${prefix}.${k}` : k;
+    if (v !== null && typeof v === 'object' && !Array.isArray(v)) flatten(v, key, out);
+    else out[key] = v;
+  }
+  return out;
+}
+const placeholders = (m) =>
+  [...new Set([...m.matchAll(/\{\s*([\w$]+)\s*\}/g)].map((x) => x[1]))].sort().join(',');
+
+const groupsByLocale = {};
+const flatByLocale = {};
+const flatByLocaleGroup = {};
+for (const loc of LOCALES) {
+  const dir = path.join(localeDir, loc);
+  const files = fs.existsSync(dir) ? fs.readdirSync(dir).filter((f) => f.endsWith('.json')) : [];
+  groupsByLocale[loc] = files.map((f) => f.replace(/\.json$/, '')).sort();
+  flatByLocale[loc] = {};
+  flatByLocaleGroup[loc] = {};
+  for (const f of files) {
+    const group = f.replace(/\.json$/, '');
+    let tree;
+    try {
+      tree = JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8'));
+    } catch (e) {
+      errors.push(`[json] ${loc}/${f} does not parse: ${e.message}`);
+      continue;
+    }
+    const flat = flatten(tree, group);
+    flatByLocaleGroup[loc][group] = flat;
+    Object.assign(flatByLocale[loc], flat);
+  }
+}
+
+const refGroups = groupsByLocale[REFERENCE];
+for (const loc of LOCALES) {
+  if (groupsByLocale[loc].join() !== refGroups.join()) {
+    errors.push(
+      `[groups] ${loc} has groups [${groupsByLocale[loc]}] but ${REFERENCE} has [${refGroups}]`,
+    );
+  }
+}
+const ref = flatByLocale[REFERENCE];
+for (const group of refGroups) {
+  const refKeys = Object.keys(flatByLocaleGroup[REFERENCE][group] ?? {});
+  for (const loc of LOCALES) {
+    if (loc === REFERENCE) continue;
+    const keys = flatByLocaleGroup[loc][group] ?? {};
+    for (const k of refKeys) if (!(k in keys)) errors.push(`[parity] missing in ${loc}: ${k}`);
+    for (const k of Object.keys(keys))
+      if (!(k in flatByLocaleGroup[REFERENCE][group])) errors.push(`[parity] only in ${loc}: ${k}`);
+  }
+}
+for (const loc of LOCALES) {
+  for (const [k, v] of Object.entries(flatByLocale[loc])) {
+    if (typeof v !== 'string' || v.trim() === '') {
+      errors.push(`[message] empty or non-string in ${loc}: ${k}`);
+      continue;
+    }
+    // literal interpolation {'@'} and named placeholders {name} are fine; anything else is not
+    const stripped = v.replace(/\{\s*'[^']*'\s*\}/g, '').replace(/\{\s*[\w$]+\s*\}/g, '');
+    if (/[@{}|]/.test(stripped))
+      errors.push(`[message] unescaped @ { } | in ${loc}: ${k} = ${JSON.stringify(v)}`);
+    if (loc !== REFERENCE && typeof ref[k] === 'string' && placeholders(v) !== placeholders(ref[k]))
+      errors.push(
+        `[message] placeholders differ in ${loc}: ${k} (${placeholders(v)} vs ${placeholders(ref[k])})`,
+      );
+  }
+}
+
+// ---------------------------------------------------------------- key usage in src
+function walk(dir, out = []) {
+  for (const ent of fs.readdirSync(dir, { withFileTypes: true })) {
+    const p = path.join(dir, ent.name);
+    if (ent.isDirectory()) {
+      if (ent.name === 'locales' || ent.name === 'node_modules') continue;
+      walk(p, out);
+    } else if (/\.(vue|ts)$/.test(ent.name) && !ent.name.endsWith('.d.ts')) out.push(p);
+  }
+  return out;
+}
+const sourceFiles = walk(srcDir);
+const groupAlt = refGroups.map((g) => g.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
+const KEY = `((?:${groupAlt})(?:\\.[A-Za-z0-9_-]+)+)`;
+const callRe = new RegExp(`(?<![\\w$])\\$?te?\\(\\s*(['"\`])${KEY}\\1`, 'g');
+const keypathRe = new RegExp(`keypath=(['"])${KEY}\\1`, 'g');
+// any other string literal that looks like a full key (key maps, switch/case returns, ...)
+const literalKeyRe = new RegExp(`(['"])${KEY}\\1`, 'g');
+// template literal keys with interpolation: `group.comp.${x}` -> prefix "group.comp."
+const dynamicKeyRe = new RegExp(`\`((?:${groupAlt})(?:\\.[A-Za-z0-9_-]+)*\\.)\\$\\{`, 'g');
+
+const usedKeys = new Set();
+const dynamicPrefixes = new Set();
+let staticUsages = 0;
+for (const file of sourceFiles) {
+  const rel = path.relative(root, file);
+  if (rel.startsWith(path.join('src', 'i18n'))) continue;
+  const content = fs.readFileSync(file, 'utf8');
+  const direct = [
+    ...[...content.matchAll(callRe)].map((m) => m[2]),
+    ...[...content.matchAll(keypathRe)].map((m) => m[2]),
+  ];
+  for (const k of direct) {
+    staticUsages++;
+    usedKeys.add(k);
+    if (typeof ref[k] !== 'string') {
+      errors.push(
+        `[usage] ${rel}: key "${k}" ${k in ref || Object.keys(ref).some((r) => r.startsWith(k + '.')) ? 'is not a message (object)' : `does not exist in ${REFERENCE}`}`,
+      );
+    }
+  }
+  for (const m of content.matchAll(literalKeyRe)) {
+    if (typeof ref[m[2]] === 'string') usedKeys.add(m[2]);
+  }
+  for (const m of content.matchAll(dynamicKeyRe)) dynamicPrefixes.add(m[1]);
+}
+let unusedVocabulary = 0;
+for (const k of Object.keys(ref)) {
+  if (usedKeys.has(k)) continue;
+  if ([...dynamicPrefixes].some((p) => k.startsWith(p))) continue;
+  if (VOCABULARY_GROUPS.includes(k.split('.')[0])) {
+    unusedVocabulary++;
+    continue;
+  }
+  errors.push(`[unused] ${k} is never used in src/`);
+}
+
+// ---------------------------------------------------------------- English text left in templates
+/** Exact strings / patterns that are fine in English (brands, abbreviations, data, formats). */
+const ALLOWED_TEXT = [
+  /^(Freqtrade|FreqUI|FreqAI|Freqtrade UI|UI|FT|N\/A|SQN|UTC|ID|OHLCV|API|URL|ROI|USDT|JSON)$/,
+  /^Freqtrader$/, // sample username placeholder
+  /^Freqtrade logo$/, // img alt text
+  /^yyyy-mm-dd$/i,
+  /^[A-Z]{2,6}$/, // short abbreviations
+  /^Spinning$/, // UProgress label prop, never rendered
+];
+const UI_ATTRS = new Set([
+  'label',
+  'title',
+  'placeholder',
+  'header',
+  'hint',
+  'help',
+  'description',
+  'text',
+  'info-text',
+  'tooltip',
+  'empty-text',
+  'empty',
+  'loading-text',
+  'aria-label',
+  'alt',
+  'subtitle',
+  'confirm-text',
+  'cancel-text',
+  'search-placeholder',
+  'name-label',
+  'editable-name',
+  'content',
+]);
+const looksEnglish = (s) => {
+  const v = s.replace(/\s+/g, ' ').trim();
+  if (!/[A-Za-z]{2,}/.test(v)) return false;
+  if (ALLOWED_TEXT.some((re) => re.test(v))) return false;
+  if (/^(i-mdi|mdi:|https?:|\/|@\/|#)/.test(v)) return false;
+  if (/^[a-z0-9_-]+$/.test(v)) return false; // snake / kebab identifiers, css tokens
+  if (/^[a-z]+[A-Z][A-Za-z0-9]*$/.test(v)) return false; // camelCase identifiers
+  if (/^[\w-]+(\.[\w-]+)+$/.test(v)) return false; // translation keys, dotted paths
+  if (
+    /^[\w-]+(\s+[\w:/[\]().%!-]+)*$/.test(v) &&
+    /(^|\s)(flex|grid|w-|h-|m[xytrbl]?-|p[xytrbl]?-|text-|bg-|border|gap-|items-|justify-|rounded|font-|col-|row-)/.test(
+      v,
+    )
+  )
+    return false; // tailwind class lists
+  return true;
+};
+const NODE = { ELEMENT: 1, TEXT: 2, COMMENT: 3, INTERPOLATION: 5, ATTRIBUTE: 6, DIRECTIVE: 7 };
+
+function stripTranslateCalls(expr) {
+  // remove t('...'), $t('...'), te('...') including simple argument objects
+  return expr.replace(/(?<![\w$])\$?te?\(\s*(['"`])[^'"`]*\1[^)]*\)/g, ' ');
+}
+function englishLiterals(expr) {
+  const out = [];
+  const cleaned = stripTranslateCalls(expr);
+  for (const m of cleaned.matchAll(/(['"`])((?:(?!\1)[^\\]|\\.)*)\1/g)) {
+    const lit = m[2];
+    if (m[1] === '`' && lit.includes('${')) {
+      const fixed = lit.replace(/\$\{[^}]*\}/g, ' ').trim();
+      if (looksEnglish(fixed) && /\s/.test(fixed)) out.push(lit);
+      continue;
+    }
+    // a single word literal in a bound attribute is usually a value/enum, require a space or capital
+    if (looksEnglish(lit) && (/\s/.test(lit.trim()) || /^[A-Z]/.test(lit))) out.push(lit);
+  }
+  return out;
+}
+
+function checkTemplate(rel, ast) {
+  const visit = (node) => {
+    if (!node) return;
+    if (node.type === NODE.TEXT) {
+      const s = node.content.trim();
+      if (s && looksEnglish(s))
+        warnings.push(`[template] ${rel}:${node.loc.start.line} text "${s}"`);
+    }
+    if (node.type === NODE.INTERPOLATION && node.content?.content) {
+      for (const lit of englishLiterals(node.content.content))
+        warnings.push(`[template] ${rel}:${node.loc.start.line} {{ }} literal "${lit}"`);
+    }
+    if (node.type === NODE.ELEMENT) {
+      for (const prop of node.props ?? []) {
+        if (prop.type === NODE.ATTRIBUTE && UI_ATTRS.has(prop.name) && prop.value) {
+          if (looksEnglish(prop.value.content))
+            warnings.push(
+              `[template] ${rel}:${prop.loc.start.line} ${prop.name}="${prop.value.content}"`,
+            );
+        } else if (
+          prop.type === NODE.DIRECTIVE &&
+          prop.name === 'bind' &&
+          prop.arg?.content &&
+          UI_ATTRS.has(prop.arg.content) &&
+          prop.exp?.content
+        ) {
+          for (const lit of englishLiterals(prop.exp.content))
+            warnings.push(`[template] ${rel}:${prop.loc.start.line} :${prop.arg.content} "${lit}"`);
+        }
+      }
+    }
+    for (const child of node.children ?? []) visit(child);
+  };
+  visit(ast);
+}
+
+const SCRIPT_UI_PROP =
+  /\b(label|title|text|header|description|placeholder|hint|tooltip|message|subtitle|emptyText|infoText)\s*:\s*(['"`])((?:(?!\2)[^\\\n]|\\.)*)\2/g;
+const SCRIPT_UI_CALL =
+  /\b(showAlert|showToast|toast\.add|alert)\(\s*(['"`])((?:(?!\2)[^\\\n]|\\.)*)\2/g;
+const SCRIPT_IGNORE_FILES = [
+  // developer-facing feature descriptions (never shown) and console-only strings
+  /src[\\/]types[\\/]/,
+];
+function checkScript(rel, code, lineOffset = 0) {
+  if (SCRIPT_IGNORE_FILES.some((re) => re.test(rel))) return;
+  const noComments = code
+    .replace(/\/\*[\s\S]*?\*\//g, (m) => m.replace(/[^\n]/g, ' '))
+    .replace(/(^|[^:\\])\/\/.*$/gm, '$1');
+  const lines = code.split('\n');
+  const lineOf = (idx) => noComments.slice(0, idx).split('\n').length;
+  for (const re of [SCRIPT_UI_PROP, SCRIPT_UI_CALL]) {
+    for (const m of noComments.matchAll(re)) {
+      const lit = m[3];
+      const line = lineOf(m.index);
+      // `// i18n-ignore` on the same line marks an intentional English literal
+      if (lines[line - 1]?.includes('i18n-ignore')) continue;
+      if (looksEnglish(lit) && (/\s/.test(lit.trim()) || /^[A-Z]/.test(lit)))
+        warnings.push(`[script] ${rel}:${lineOffset + line} ${m[1]}: "${lit}"`);
+    }
+  }
+}
+
+const CJK = /[\u3400-\u9fff\uff00-\uffef]/;
+const CJK_ALLOWED_FILES = [path.join('src', 'i18n', 'index.ts')];
+for (const file of sourceFiles) {
+  const rel = path.relative(root, file);
+  const content = fs.readFileSync(file, 'utf8');
+  if (!CJK_ALLOWED_FILES.includes(rel)) {
+    content.split('\n').forEach((line, i) => {
+      const code = line.replace(/\/\/.*$/, '').replace(/<!--.*?-->/g, '');
+      if (CJK.test(code)) warnings.push(`[cjk] ${rel}:${i + 1} hard-coded Chinese: ${line.trim()}`);
+    });
+  }
+  if (file.endsWith('.vue')) {
+    const { descriptor, errors: sfcErrors } = parseSfc(content, { filename: file });
+    if (sfcErrors.length) {
+      warnings.push(`[sfc] ${rel}: could not parse (${sfcErrors[0].message})`);
+      continue;
+    }
+    if (descriptor.template?.ast) checkTemplate(rel, descriptor.template.ast);
+    for (const block of [descriptor.script, descriptor.scriptSetup]) {
+      if (block) checkScript(rel, block.content, block.loc.start.line - 1);
+    }
+  } else if (!rel.startsWith(path.join('src', 'i18n'))) {
+    checkScript(rel, content);
+  }
+}
+
+// ---------------------------------------------------------------- report
+const total = Object.keys(ref).length;
+console.log(
+  `i18n: ${refGroups.length} groups (${refGroups.join(', ')}), ${total} keys per locale, ` +
+    `${staticUsages} static key usages, ${dynamicPrefixes.size} dynamic key prefixes ` +
+    `(${[...dynamicPrefixes].join(', ')}), ` +
+    `${unusedVocabulary} not yet used shared vocabulary keys (${VOCABULARY_GROUPS.join(', ')}.*)`,
+);
+if (errors.length) {
+  console.log(`\nERRORS (${errors.length}):`);
+  for (const e of errors) console.log('  ' + e);
+} else {
+  console.log('errors: none (json ok, en/zh-CN parity ok, no missing or unused keys)');
+}
+if (warnings.length) {
+  console.log(`\nWARNINGS - possibly untranslated / hard-coded text (${warnings.length}):`);
+  if (!quiet) for (const w of warnings) console.log('  ' + w);
+} else {
+  console.log('warnings: none (no likely-English UI text found)');
+}
+process.exitCode = errors.length || (strict && warnings.length) ? 1 : 0;
