+#!/usr/bin/env node
+/**
+ * Screenshots of the localized FreqUI against a mocked bot API (zh-CN localization patch).
+ *
+ * Usage (after `pnpm build`):
+ *   node scripts/zh-screenshots.mjs [--out <dir>] [--locale zh-CN|en] [--port 4180]
+ *                                    [--base-url http://localhost:3000]  (skip own server)
+ *
+ * Without --base-url it starts `vite preview` on --port and stops it afterwards.
+ * Uses the e2e fixtures in e2e/testData plus synthetic USDT-M futures trades, so the pages
+ * look like a futures bot (long / short, leverage, funding fees). Nothing is sent anywhere:
+ * every request to /api/v1/ is answered by Playwright route mocks.
+ *
+ * Pages: login, dashboard, trade (open trades), backtest (loaded result), chart, settings.
+ */
+import fs from 'node:fs';
+import path from 'node:path';
+import process from 'node:process';
+import { spawn } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { chromium } from '@playwright/test';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const argv = process.argv.slice(2);
+const arg = (name, fallback) => {
+  const i = argv.indexOf(`--${name}`);
+  return i >= 0 && argv[i + 1] ? argv[i + 1] : fallback;
+};
+const outDir = path.resolve(arg('out', path.join(root, 'screenshots')));
+const locale = arg('locale', 'zh-CN');
+const port = Number(arg('port', '4180'));
+const externalBaseUrl = arg('base-url', '');
+const baseURL = externalBaseUrl || `http://localhost:${port}`;
+const testData = path.join(root, 'e2e', 'testData');
+const fixture = (name) => JSON.parse(fs.readFileSync(path.join(testData, name), 'utf8'));
+
+// ------------------------------------------------------------------ locale texts for locators
+function loadMessages(loc) {
+  const dir = path.join(root, 'src', 'locales', loc);
+  const msgs = {};
+  for (const f of fs.readdirSync(dir).filter((x) => x.endsWith('.json')))
+    msgs[f.replace(/\.json$/, '')] = JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8'));
+  return msgs;
+}
+const messages = loadMessages(locale);
+const L = (key) => {
+  const v = key.split('.').reduce((o, k) => (o ? o[k] : undefined), messages);
+  if (typeof v !== 'string') throw new Error(`no message ${key} in ${locale}`);
+  return v;
+};
+
+// ------------------------------------------------------------------ synthetic futures data
+let seed = 42;
+const rnd = () => {
+  seed = (seed * 16807) % 2147483647;
+  return (seed - 1) / 2147483646;
+};
+const NOW = Date.now();
+const MIN = 60_000;
+const fmtDate = (ts) => new Date(ts).toISOString().replace('T', ' ').slice(0, 19);
+const PAIRS = {
+  'BTC/USDT:USDT': 68250,
+  'ETH/USDT:USDT': 3480,
+  'SOL/USDT:USDT': 172.4,
+  'BNB/USDT:USDT': 612.3,
+  'XRP/USDT:USDT': 0.6231,
+  'DOGE/USDT:USDT': 0.1618,
+};
+const PAIR_NAMES = Object.keys(PAIRS);
+const template = fixture('trades.json').trades[0];
+const EXIT_REASONS = [
+  'roi',
+  'exit_signal',
+  'stop_loss',
+  'trailing_stop_loss',
+  'roi',
+  'exit_signal',
+];
+
+function makeTrade(id, { open }) {
+  const pair = PAIR_NAMES[id % PAIR_NAMES.length];
+  const [base] = pair.split('/');
+  const isShort = id % 3 === 1;
+  const leverage = [3, 5, 2][id % 3];
+  const stake = Math.round(150 + rnd() * 250);
+  const openRate = +(PAIRS[pair] * (0.94 + rnd() * 0.12)).toPrecision(6);
+  const amount = +((stake * leverage) / openRate).toPrecision(5);
+  const openTs = open ? NOW - (30 + id * 47) * MIN : NOW - (30 - id * 0.7) * 24 * 60 * MIN;
+  const durationMin = Math.round(25 + rnd() * 600);
+  const closeTs = open ? null : openTs + durationMin * MIN;
+  const move = (rnd() - 0.42) * 0.045; // price move, slightly positive edge
+  const priceRatio = isShort ? -move : move;
+  const exitRate = +(openRate * (1 + move)).toPrecision(6);
+  const profitRatio = +(priceRatio * leverage - 0.0008 * leverage).toFixed(5);
+  const profitAbs = +(stake * profitRatio).toFixed(4);
+  const stopRatio = -0.1;
+  const stopAbs = +(openRate * (isShort ? 1 + 0.1 / leverage : 1 - 0.1 / leverage)).toPrecision(6);
+  const liq = +(openRate * (isShort ? 1 + 0.9 / leverage : 1 - 0.9 / leverage)).toPrecision(6);
+  const entryOrder = {
+    ...template.orders[0],
+    pair,
+    amount,
+    filled: amount,
+    safe_price: openRate,
+    average: openRate,
+    price: openRate,
+    cost: stake * leverage,
+    ft_order_side: isShort ? 'sell' : 'buy',
+    order_type: 'limit',
+    order_id: `dry_run_entry_${id}`,
+    order_date: fmtDate(openTs),
+    order_timestamp: openTs,
+    order_filled_date: fmtDate(openTs + 2000),
+    order_filled_timestamp: openTs + 2000,
+  };
+  const exitOrder = open
+    ? []
+    : [
+        {
+          ...template.orders[1],
+          pair,
+          amount,
+          filled: amount,
+          safe_price: exitRate,
+          average: exitRate,
+          price: exitRate,
+          cost: amount * exitRate,
+          ft_order_side: isShort ? 'buy' : 'sell',
+          order_type: 'market',
+          order_id: `dry_run_exit_${id}`,
+          order_date: fmtDate(closeTs - 3000),
+          order_timestamp: closeTs - 3000,
+          order_filled_date: fmtDate(closeTs),
+          order_filled_timestamp: closeTs,
+        },
+      ];
+  const trade = {
+    ...template,
+    trade_id: id,
+    pair,
+    base_currency: base,
+    quote_currency: 'USDT',
+    is_open: open,
+    exchange: 'binance',
+    strategy: 'EasyTradeFutures',
+    timeframe: 5,
+    amount,
+    amount_requested: amount,
+    stake_amount: stake,
+    max_stake_amount: stake,
+    enter_tag: isShort ? 'ema_cross_short' : 'ema_cross_long',
+    open_date: fmtDate(openTs),
+    open_timestamp: openTs,
+    open_rate: openRate,
+    open_rate_requested: openRate,
+    open_trade_value: stake * leverage,
+    fee_open_cost: stake * leverage * 0.0005,
+    fee_open_currency: 'USDT',
+    leverage,
+    is_short: isShort,
+    trading_mode: 'futures',
+    margin_mode: 'isolated',
+    liquidation_price: liq,
+    funding_fees: -+(stake * 0.0004 * (1 + (id % 4))).toFixed(4),
+    interest_rate: 0,
+    stop_loss_abs: stopAbs,
+    stop_loss_ratio: stopRatio,
+    stop_loss_pct: stopRatio * 100,
+    initial_stop_loss_abs: stopAbs,
+    initial_stop_loss_ratio: stopRatio,
+    initial_stop_loss_pct: stopRatio * 100,
+    stoploss_last_update: fmtDate(openTs + 5000),
+    stoploss_last_update_timestamp: openTs + 5000,
+    min_rate: +(openRate * 0.985).toPrecision(6),
+    max_rate: +(openRate * 1.02).toPrecision(6),
+    realized_profit: 0,
+    profit_ratio: profitRatio,
+    profit_pct: +(profitRatio * 100).toFixed(2),
+    profit_abs: profitAbs,
+    has_open_orders: false,
+    open_order_id: null,
+    orders: [entryOrder, ...exitOrder],
+  };
+  if (open) {
+    Object.assign(trade, {
+      close_date: null,
+      close_timestamp: null,
+      close_rate: null,
+      close_rate_requested: null,
+      close_profit: null,
+      close_profit_pct: null,
+      close_profit_abs: null,
+      trade_duration_s: null,
+      trade_duration: null,
+      exit_reason: null,
+      sell_reason: null,
+      exit_order_status: null,
+      current_rate: exitRate,
+      total_profit_abs: profitAbs,
+      total_profit_ratio: profitRatio,
+      total_profit_fiat: profitAbs,
+      stoploss_current_dist: +(stopAbs - exitRate).toPrecision(6),
+      stoploss_current_dist_ratio: +((stopAbs - exitRate) / exitRate).toFixed(5),
+      stoploss_current_dist_pct: +(((stopAbs - exitRate) / exitRate) * 100).toFixed(2),
+      stoploss_entry_dist: +(stopAbs - openRate).toPrecision(6),
+      stoploss_entry_dist_ratio: +((stopAbs - openRate) / openRate).toFixed(5),
+    });
+  } else {
+    Object.assign(trade, {
+      close_date: fmtDate(closeTs),
+      close_timestamp: closeTs,
+      close_rate: exitRate,
+      close_rate_requested: exitRate,
+      close_profit: profitRatio,
+      close_profit_pct: +(profitRatio * 100).toFixed(2),
+      close_profit_abs: profitAbs,
+      trade_duration_s: durationMin * 60,
+      trade_duration: durationMin,
+      exit_reason: profitRatio < -0.02 ? 'stop_loss' : EXIT_REASONS[id % EXIT_REASONS.length],
+      exit_order_status: 'closed',
+      fee_close_cost: amount * exitRate * 0.0005,
+      fee_close_currency: 'USDT',
+    });
+  }
+  return trade;
+}
+
+const closedTrades = Array.from({ length: 42 }, (_, i) => makeTrade(i + 1, { open: false }));
+const openTrades = [43, 44, 45, 46].map((id) => makeTrade(id, { open: true }));
+const allTrades = [...closedTrades].reverse();
+
+const dailyData = (() => {
+  const days = [];
+  let balance = 2000;
+  for (let d = 19; d >= 0; d--) {
+    const date = new Date(NOW - d * 86400_000).toISOString().slice(0, 10);
+    const dayTrades = closedTrades.filter((t) => t.close_date.slice(0, 10) === date);
+    const abs = dayTrades.reduce((a, t) => a + t.profit_abs, 0);
+    days.push({
+      date,
+      abs_profit: +abs.toFixed(4),
+      rel_profit: +(abs / balance).toFixed(5),
+      starting_balance: +balance.toFixed(2),
+      fiat_value: +abs.toFixed(2),
+      trade_count: dayTrades.length,
+    });
+    balance += abs;
+  }
+  return { data: days.reverse(), fiat_display_currency: 'USD', stake_currency: 'USDT' };
+})();
+
+const walletHistory = (() => {
+  let total = 2000;
+  const data = [];
+  for (const t of closedTrades) {
+    total += t.profit_abs;
+    data.push([fmtDate(t.close_timestamp), t.close_timestamp, 'USDT', +total.toFixed(4)]);
+  }
+  return {
+    columns: ['date', '__date_ts', 'currency', 'total_quote'],
+    length: data.length,
+    data,
+    capture_start_ts: closedTrades[0].open_timestamp,
+  };
+})();
+
+const closedProfit = closedTrades.reduce((a, t) => a + t.profit_abs, 0);
+const openProfit = openTrades.reduce((a, t) => a + t.profit_abs, 0);
+const wins = closedTrades.filter((t) => t.profit_abs > 0).length;
+const profit = {
+  ...fixture('profit.json'),
+  profit_closed_coin: +closedProfit.toFixed(4),
+  profit_closed_ratio: +(closedProfit / 2000).toFixed(5),
+  profit_closed_percent: +((closedProfit / 2000) * 100).toFixed(2),
+  profit_closed_fiat: +closedProfit.toFixed(2),
+  profit_all_coin: +(closedProfit + openProfit).toFixed(4),
+  profit_all_ratio: +((closedProfit + openProfit) / 2000).toFixed(5),
+  profit_all_percent: +(((closedProfit + openProfit) / 2000) * 100).toFixed(2),
+  profit_all_fiat: +(closedProfit + openProfit).toFixed(2),
+  trade_count: closedTrades.length + openTrades.length,
+  closed_trade_count: closedTrades.length,
+  first_trade_date: '30 days ago',
+  first_trade_timestamp: closedTrades[0].open_timestamp,
+  latest_trade_date: '2 hours ago',
+  latest_trade_timestamp: openTrades[0].open_timestamp,
+  best_pair: 'SOL/USDT:USDT',
+  winning_trades: wins,
+  losing_trades: closedTrades.length - wins,
+  bot_start_timestamp: closedTrades[0].open_timestamp - 3600_000,
+};
+
+const performance = PAIR_NAMES.map((pair) => {
+  const ts = closedTrades.filter((t) => t.pair === pair);
+  const abs = ts.reduce((a, t) => a + t.profit_abs, 0);
+  const ratio = ts.reduce((a, t) => a + t.profit_ratio, 0);
+  return {
+    pair,
+    profit: +(ratio * 100).toFixed(2),
+    profit_ratio: +ratio.toFixed(5),
+    profit_pct: +(ratio * 100).toFixed(2),
+    profit_abs: +abs.toFixed(4),
+    count: ts.length,
+  };
+}).sort((a, b) => b.profit_abs - a.profit_abs);
+
+const showConfig = {
+  ...fixture('show_config.json'),
+  trading_mode: 'futures',
+  margin_mode: 'isolated',
+  exchange: 'binance',
+  strategy: 'EasyTradeFutures',
+  timeframe: '5m',
+  dry_run: true,
+  runmode: 'dry_run',
+  bot_name: 'EasyTrade',
+  short_allowed: true,
+  max_open_trades: 5,
+  stake_amount: 'unlimited',
+};
+
+const balance = (() => {
+  const b = fixture('balance.json');
+  return { ...b, total: 2000 + closedProfit, value: 2000 + closedProfit, starting_capital: 2000 };
+})();
+
+const whitelist = { whitelist: PAIR_NAMES, length: PAIR_NAMES.length, method: ['VolumePairList'] };
+const candleFixture = fixture('pair_candles_btc_1m.json');
+
+// ------------------------------------------------------------------ mocking
+/**
+ * Nuxt UI loads icons at runtime from api.iconify.design. Answer those requests from the
+ * locally installed @iconify-json sets, so screenshots work offline and are deterministic.
+ */
+const iconSets = {};
+const missingIcons = new Set();
+// Nuxt UI's own lucide icons (not installed as @iconify-json/lucide); 24x24 stroke icons.
+const lucide = (paths) =>
+  `<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">${paths}</g>`;
+const FALLBACK_ICONS = {
+  lucide: {
+    width: 24,
+    height: 24,
+    icons: Object.fromEntries(
+      Object.entries({
+        check: '<path d="M20 6 9 17l-5-5"/>',
+        x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
+        minus: '<path d="M5 12h14"/>',
+        plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
+        'chevron-down': '<path d="m6 9 6 6 6-6"/>',
+        'chevron-up': '<path d="m18 15-6-6-6 6"/>',
+        'chevron-left': '<path d="m15 18-6-6 6-6"/>',
+        'chevron-right': '<path d="m9 18 6-6-6-6"/>',
+        'chevrons-left': '<path d="m11 17-5-5 5-5"/><path d="m18 17-5-5 5-5"/>',
+        'chevrons-right': '<path d="m6 17 5-5-5-5"/><path d="m13 17 5-5-5-5"/>',
+        search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
+      }).map(([name, paths]) => [name, { body: lucide(paths) }]),
+    ),
+  },
+};
+function iconSet(prefix) {
+  if (!(prefix in iconSets)) {
+    const file = path.join(root, 'node_modules', '@iconify-json', prefix, 'icons.json');
+    iconSets[prefix] = fs.existsSync(file)
+      ? JSON.parse(fs.readFileSync(file, 'utf8'))
+      : FALLBACK_ICONS[prefix] || null;
+  }
+  return iconSets[prefix];
+}
+async function mockIcons(page) {
+  await page.route('https://api.iconify.design/**', (route) => {
+    const url = new URL(route.request().url());
+    const prefix = url.pathname.replace(/^\//, '').replace(/\.json$/, '');
+    const names = (url.searchParams.get('icons') || '').split(',').filter(Boolean);
+    const set = iconSet(prefix);
+    const body = { prefix, icons: {}, width: set?.width ?? 24, height: set?.height ?? 24 };
+    const notFound = [];
+    for (const name of names) {
+      const target = set?.icons?.[name] ?? set?.icons?.[set?.aliases?.[name]?.parent];
+      if (target) body.icons[name] = target;
+      else notFound.push(name);
+    }
+    if (notFound.length) {
+      body.not_found = notFound;
+      for (const n of notFound) missingIcons.add(`${prefix}:${n}`);
+    }
+    return route.fulfill({ headers: { 'access-control-allow-origin': '*' }, json: body });
+  });
+}
+
+async function mockApi(page, { backtest = false } = {}) {
+  await mockIcons(page);
+  const json = (route, body) =>
+    route.fulfill({ headers: { 'access-control-allow-origin': '*' }, json: body });
+  await page.route('**/api/v1/**', (route) => {
+    const url = new URL(route.request().url());
+    const p = url.pathname.replace(/^.*\/api\/v1/, '');
+    const method = route.request().method();
+    switch (p) {
+      case '/ping':
+        return json(route, { status: 'pong' });
+      case '/show_config':
+        return backtest
+          ? json(route, fixture('backtest/show_config_webserver.json'))
+          : json(route, showConfig);
+      case '/status':
+        return json(route, openTrades);
+      case '/trades':
+        return json(route, {
+          trades: allTrades,
+          trades_count: allTrades.length,
+          offset: 0,
+          total_trades: allTrades.length,
+        });
+      case '/profit':
+        return json(route, profit);
+      case '/profit_all':
+        return json(route, { all: profit, long: profit, short: profit });
+      case '/balance':
+        return json(route, balance);
+      case '/locks':
+        return json(route, fixture('locks_empty.json'));
+      case '/performance':
+        return json(route, performance);
+      case '/daily':
+      case '/weekly':
+      case '/monthly':
+        return json(route, dailyData);
+      case '/historic_balance':
+        return json(route, walletHistory);
+      case '/whitelist':
+        return json(route, backtest ? fixture('whitelist.json') : whitelist);
+      case '/blacklist':
+        return json(route, fixture('blacklist.json'));
+      case '/logs':
+        return json(route, fixture('logs.json'));
+      case '/strategies':
+        return json(route, fixture('backtest/strategies.json'));
+      case '/background':
+        return json(route, []);
+      case '/backtest/history':
+        return json(route, []);
+      case '/backtest':
+        return method === 'POST'
+          ? json(route, fixture('backtest/backtest_post_start.json'))
+          : json(route, fixture('backtest/backtest_get_end.json'));
+      case '/pair_candles':
+      case '/pair_history': {
+        const pair = url.searchParams.get('pair') || 'BTC/USDT:USDT';
+        return json(route, { ...candleFixture, pair, strategy: 'EasyTradeFutures' });
+      }
+      default:
+        return json(route, {});
+    }
+  });
+}
+
+function storageState({ loggedIn }) {
+  const ls = [{ name: 'ftUISettings', value: JSON.stringify({ locale }) }];
+  if (loggedIn) {
+    ls.push(
+      {
+        name: 'ftAuthLoginInfo',
+        value: JSON.stringify({
+          'ftbot.0': {
+            botName: 'EasyTrade',
+            apiUrl: baseURL,
+            accessToken: 'access_token_test',
+            refreshToken: 'refresh_test',
+            autoRefresh: true,
+          },
+        }),
+      },
+      { name: 'ftSelectedBot', value: 'ftbot.0' },
+    );
+  }
+  return { cookies: [], origins: [{ origin: baseURL, localStorage: ls }] };
+}
+
+async function newPage(browser, { loggedIn = true, backtest = false } = {}) {
+  const context = await browser.newContext({
+    baseURL,
+    viewport: { width: 1440, height: 900 },
+    deviceScaleFactor: 1,
+    locale: locale === 'zh-CN' ? 'zh-CN' : 'en-US',
+    timezoneId: 'Asia/Shanghai',
+    storageState: storageState({ loggedIn }),
+  });
+  const page = await context.newPage();
+  page.on('pageerror', (err) => console.log(`  [pageerror] ${err.message}`));
+  await mockApi(page, { backtest });
+  return page;
+}
+
+const settle = (page, ms = 1200) => page.waitForTimeout(ms);
+async function shot(page, name, { fullPage = false } = {}) {
+  const file = path.join(outDir, `${name}.png`);
+  await page.screenshot({ path: file });
+  console.log(`  saved ${file}`);
+  if (fullPage) {
+    // the app scrolls inside its main container, so grow the viewport to the content height
+    const height = await page.evaluate(() =>
+      Math.max(...[...document.querySelectorAll('*')].map((e) => e.scrollHeight)),
+    );
+    await page.setViewportSize({ width: 1440, height: Math.min(Math.max(height, 900), 6000) });
+    await settle(page, 800);
+    const fullFile = path.join(outDir, `${name}-full.png`);
+    await page.screenshot({ path: fullFile, fullPage: true });
+    console.log(`  saved ${fullFile}`);
+  }
+  await page.context().close();
+}
+
+// ------------------------------------------------------------------ server
+async function waitForServer(url, timeoutMs = 30_000) {
+  const start = Date.now();
+  while (Date.now() - start < timeoutMs) {
+    try {
+      const res = await fetch(url);
+      if (res.ok) return;
+    } catch {
+      // not up yet
+    }
+    await new Promise((r) => setTimeout(r, 300));
+  }
+  throw new Error(`server ${url} did not start`);
+}
+
+let server;
+if (!externalBaseUrl) {
+  if (!fs.existsSync(path.join(root, 'dist', 'index.html')))
+    throw new Error('dist/ missing - run `pnpm build` first');
+  server = spawn(
+    path.join(root, 'node_modules', '.bin', 'vite'),
+    ['preview', '--port', String(port), '--strictPort'],
+    { cwd: root, stdio: 'ignore' },
+  );
+}
+
+fs.mkdirSync(outDir, { recursive: true });
+async function launchBrowser() {
+  if (process.env.SCREENSHOT_CHROME)
+    return chromium.launch({ executablePath: process.env.SCREENSHOT_CHROME });
+  try {
+    return await chromium.launch(); // browser downloaded by `playwright install chromium`
+  } catch {
+    return chromium.launch({ channel: 'chrome' }); // installed Google Chrome
+  }
+}
+const browser = await launchBrowser();
+try {
+  await waitForServer(baseURL);
+  console.log(`screenshots (${locale}) from ${baseURL} -> ${outDir}`);
+
+  // login
+  let page = await newPage(browser, { loggedIn: false });
+  await page.goto('/login');
+  await page.waitForSelector('input[type=password]');
+  await settle(page, 600);
+  await shot(page, 'login');
+
+  // dashboard
+  page = await newPage(browser);
+  await Promise.all([page.waitForResponse('**/api/v1/trades*'), page.goto('/dashboard')]);
+  await settle(page, 2000);
+  await shot(page, 'dashboard');
+
+  // trade page with open trades
+  page = await newPage(browser);
+  await Promise.all([page.waitForResponse('**/api/v1/status'), page.goto('/trade')]);
+  await page.waitForSelector(`text=${openTrades[0].pair}`);
+  await settle(page, 2000);
+  await shot(page, 'trade');
+
+  // backtest with a loaded result
+  page = await newPage(browser, { backtest: true });
+  await page.goto('/backtest');
+  await page.locator('#strategy-select svg').click();
+  await page.getByRole('option', { name: 'SampleStrategy' }).click();
+  await Promise.all([
+    page.waitForResponse('**/api/v1/backtest'),
+    page.getByRole('button', { name: L('ftbotA.backtestRun.startBacktest') }).click(),
+  ]);
+  const analyzeTab = page.getByRole('tab', {
+    name: L('chartsPages.backtestPage.tabs.analyzeResult'),
+  });
+  await analyzeTab.click();
+  await settle(page, 1500);
+  await shot(page, 'backtest', { fullPage: true });
+
+  // chart page
+  page = await newPage(browser);
+  await Promise.all([page.waitForResponse('**/api/v1/pair_candles*'), page.goto('/graph')]);
+  await page
+    .getByRole('button', { name: L('chartsPages.candleChartContainer.refreshChart') })
+    .click();
+  await settle(page, 2000);
+  await shot(page, 'chart');
+
+  // settings
+  page = await newPage(browser);
+  await page.goto('/settings');
+  await settle(page, 1000);
+  await shot(page, 'settings', { fullPage: true });
+  if (missingIcons.size) console.log(`  icons without local data: ${[...missingIcons].join(', ')}`);
+} finally {
+  await browser.close();
+  server?.kill();
+}
