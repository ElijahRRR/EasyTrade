diff --git a/src/i18n/index.ts b/src/i18n/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6e4c04268e8dcb4a563ef9b1bedfd1841697c1a5
--- /dev/null
+++ b/src/i18n/index.ts
@@ -0,0 +1,157 @@
+/**
+ * FreqUI localization (zh-CN / en).
+ *
+ * Messages live in `src/locales/<locale>/<group>.json`. Every file is mounted under its
+ * file name, so `src/locales/en/layout.json` containing
+ * `{ "navBar": { "nav": { "trade": "Trade" } } }`
+ * is available under the key `layout.navBar.nav.trade`.
+ *
+ * Files are picked up automatically (import.meta.glob, eager) - adding a new group only
+ * requires adding the two json files, no change in this file.
+ *
+ * See I18N_GUIDE.md in the repository root for conventions.
+ */
+import { createI18n } from 'vue-i18n';
+import type { Composer } from 'vue-i18n';
+import type { Locale as DateFnsLocale } from 'date-fns';
+import { enUS } from 'date-fns/locale/en-US';
+import { zhCN } from 'date-fns/locale/zh-CN';
+
+export const SUPPORTED_LOCALES = ['zh-CN', 'en'] as const;
+export type SupportedLocale = (typeof SUPPORTED_LOCALES)[number];
+
+export const DEFAULT_LOCALE: SupportedLocale = 'zh-CN';
+export const FALLBACK_LOCALE: SupportedLocale = 'en';
+
+/** Options for the language switcher. Labels are intentionally NOT translated. */
+export const LOCALE_OPTIONS: { value: SupportedLocale; label: string }[] = [
+  { value: 'zh-CN', label: '中文' },
+  { value: 'en', label: 'English' },
+];
+
+export interface MessageTree {
+  [key: string]: string | MessageTree;
+}
+export type LocaleMessages = Record<string, Record<string, MessageTree>>;
+
+/**
+ * Merge per-group locale files into one message object per locale.
+ * @param files Map of `<anything>/locales/<locale>/<group>.json` -> parsed json content
+ */
+export function buildMessages(files: Record<string, MessageTree>): LocaleMessages {
+  const messages: LocaleMessages = {};
+  for (const [path, content] of Object.entries(files)) {
+    const match = /\/locales\/([^/]+)\/([^/]+)\.json$/.exec(path);
+    if (!match || !match[1] || !match[2]) {
+      continue;
+    }
+    const locale = match[1];
+    const group = match[2];
+    if (!messages[locale]) {
+      messages[locale] = {};
+    }
+    messages[locale][group] = content;
+  }
+  return messages;
+}
+
+const localeFiles = import.meta.glob<MessageTree>('../locales/*/*.json', {
+  eager: true,
+  import: 'default',
+});
+
+export const messages = buildMessages(localeFiles);
+
+export const i18n = createI18n({
+  legacy: false,
+  globalInjection: true,
+  locale: DEFAULT_LOCALE,
+  fallbackLocale: FALLBACK_LOCALE,
+  messages,
+  // Warn about keys that don't exist at all (typos) during development.
+  missingWarn: import.meta.env.DEV,
+  fallbackWarn: false,
+});
+
+/**
+ * Global translate function for plain TypeScript (stores, utils, ECharts option builders).
+ * Call it lazily (inside functions / computed), never at module top level,
+ * otherwise the text will not follow locale changes.
+ */
+export const t: Composer['t'] = i18n.global.t;
+/**
+ * Check if a translation key exists in the current locale or the fallback locale.
+ * Without a locale argument, vue-i18n (11.4+) checks the same locale chain as t() - the
+ * dynamic-key helpers (`te(key) ? t(key) : value`) rely on that, tests/unit/i18n.spec.ts pins it.
+ * With an explicit locale (`te(key, 'zh-CN')`) only that locale is checked.
+ */
+export const te: Composer['te'] = i18n.global.te;
+
+export function isSupportedLocale(value: unknown): value is SupportedLocale {
+  return typeof value === 'string' && (SUPPORTED_LOCALES as readonly string[]).includes(value);
+}
+
+/** Map arbitrary input (persisted value, navigator.language, ...) to a supported locale */
+export function normalizeLocale(value: unknown): SupportedLocale {
+  if (isSupportedLocale(value)) {
+    return value;
+  }
+  if (typeof value === 'string') {
+    const lower = value.toLowerCase();
+    if (lower.startsWith('zh')) {
+      return 'zh-CN';
+    }
+    if (lower.startsWith('en')) {
+      return 'en';
+    }
+  }
+  return DEFAULT_LOCALE;
+}
+
+/** Currently active locale (reactive when read inside computed / templates) */
+export function getLocale(): SupportedLocale {
+  return normalizeLocale(i18n.global.locale.value);
+}
+
+/**
+ * Activate a locale. Usually called through the settings store (settingsStore.locale),
+ * which persists the choice - App.vue keeps both in sync.
+ * @returns the locale that was actually applied
+ */
+export function setLocale(value: unknown): SupportedLocale {
+  const locale = normalizeLocale(value);
+  i18n.global.locale.value = locale;
+  if (typeof document !== 'undefined') {
+    document.documentElement.lang = locale;
+  }
+  return locale;
+}
+
+/** Options for `humanize-duration`, matching the active locale */
+export function getHumanizeDurationOptions(): {
+  language: 'zh_CN' | 'en';
+  delimiter?: string;
+  spacer?: string;
+} {
+  if (getLocale() === 'zh-CN') {
+    // "1天 2小时 3分钟" instead of "1 天, 2 小时, 3 分钟"
+    return { language: 'zh_CN', delimiter: ' ', spacer: '' };
+  }
+  return { language: 'en' };
+}
+
+/** date-fns locale object - pass as `{ locale: getDateFnsLocale() }` to format() */
+export function getDateFnsLocale(): DateFnsLocale {
+  return getLocale() === 'zh-CN' ? zhCN : enUS;
+}
+
+/**
+ * ECharts built-in locale name (toolbox / dataZoom / time axis labels).
+ * Already applied to all charts via App.vue (vue-echarts INIT_OPTIONS_KEY).
+ * @param locale defaults to the active locale
+ */
+export function getEChartsLocale(locale: unknown = getLocale()): 'ZH' | 'EN' {
+  return normalizeLocale(locale) === 'zh-CN' ? 'ZH' : 'EN';
+}
+
+export default i18n;
