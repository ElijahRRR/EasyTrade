+// Global vitest setup (see `test.setupFiles` in vite.config.ts)
+import { config } from '@vue/test-utils';
+import i18n, { setLocale } from '@/i18n';
+
+// Tests assert on English output - keep them independent of the UI default (zh-CN).
+setLocale('en');
+
+// Components using useI18n() / $t need the plugin installed when mounted in tests.
+config.global.plugins = [...(config.global.plugins ?? []), i18n];
diff --git a/tests/unit/i18n.spec.ts b/tests/unit/i18n.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..537e2b2f1def4f140268be8b9486189ac1d159e5
--- /dev/null
+++ b/tests/unit/i18n.spec.ts
@@ -0,0 +1,185 @@
+import { describe, expect, it } from 'vitest';
+import {
+  buildMessages,
+  FALLBACK_LOCALE,
+  getLocale,
+  i18n,
+  setLocale,
+  SUPPORTED_LOCALES,
+  t,
+  te,
+} from '@/i18n';
+import { formatTimedelta } from '@/utils/formatters/timeformat';
+import type { MessageTree } from '@/i18n';
+
+// Same files the app loads (src/i18n/index.ts), loaded again to check them file by file.
+const localeFiles = import.meta.glob<MessageTree>('/src/locales/*/*.json', {
+  eager: true,
+  import: 'default',
+});
+const sourceFiles = import.meta.glob<string>(['/src/**/*.vue', '/src/**/*.ts'], {
+  eager: true,
+  query: '?raw',
+  import: 'default',
+});
+
+function flatten(tree: MessageTree, prefix = ''): Record<string, string> {
+  const out: Record<string, string> = {};
+  for (const [key, value] of Object.entries(tree)) {
+    const fullKey = prefix ? `${prefix}.${key}` : key;
+    if (typeof value === 'string') {
+      out[fullKey] = value;
+    } else {
+      Object.assign(out, flatten(value, fullKey));
+    }
+  }
+  return out;
+}
+
+function placeholders(message: string): string[] {
+  const names = [...message.matchAll(/\{\s*([\w$]+)\s*\}/g)].map((m) => m[1]);
+  return [...new Set(names)].sort();
+}
+
+const messages = buildMessages(localeFiles);
+const flat: Record<string, Record<string, string>> = {};
+for (const locale of SUPPORTED_LOCALES) {
+  flat[locale] = flatten((messages[locale] ?? {}) as MessageTree);
+}
+const reference = flat[FALLBACK_LOCALE] ?? {};
+
+describe('i18n locale files', () => {
+  it('has the same group files for every locale', () => {
+    const referenceGroups = Object.keys(messages[FALLBACK_LOCALE] ?? {}).sort();
+    expect(referenceGroups.length).toBeGreaterThan(0);
+    for (const locale of SUPPORTED_LOCALES) {
+      expect(Object.keys(messages[locale] ?? {}).sort(), `groups of ${locale}`).toEqual(
+        referenceGroups,
+      );
+    }
+  });
+
+  it('has the same keys for every locale', () => {
+    const referenceKeys = Object.keys(reference);
+    for (const locale of SUPPORTED_LOCALES) {
+      const keys = Object.keys(flat[locale] ?? {});
+      const missing = referenceKeys.filter((k) => !keys.includes(k));
+      const extra = keys.filter((k) => !referenceKeys.includes(k));
+      expect(missing, `keys missing in ${locale}`).toEqual([]);
+      expect(extra, `keys only in ${locale}`).toEqual([]);
+    }
+  });
+
+  it('has no empty messages', () => {
+    for (const locale of SUPPORTED_LOCALES) {
+      const empty = Object.entries(flat[locale] ?? {})
+        .filter(([, v]) => v.trim() === '')
+        .map(([k]) => k);
+      expect(empty, `empty messages in ${locale}`).toEqual([]);
+    }
+  });
+
+  it('uses the same {placeholders} in every locale', () => {
+    const mismatches: string[] = [];
+    for (const [key, refMsg] of Object.entries(reference)) {
+      const expected = placeholders(refMsg);
+      for (const locale of SUPPORTED_LOCALES) {
+        const msg = flat[locale]?.[key];
+        if (msg !== undefined && placeholders(msg).join(',') !== expected.join(',')) {
+          mismatches.push(`${locale}: ${key}`);
+        }
+      }
+    }
+    expect(mismatches).toEqual([]);
+  });
+
+  it('has no unescaped vue-i18n special characters', () => {
+    // '@' starts a linked message, unbalanced braces break the message compiler.
+    // Write literal characters as {'@'}, {'{'}, {'}'}, {'|'}.
+    const bad: string[] = [];
+    for (const locale of SUPPORTED_LOCALES) {
+      for (const [key, msg] of Object.entries(flat[locale] ?? {})) {
+        const stripped = msg.replace(/\{\s*'[^']*'\s*\}/g, '').replace(/\{\s*[\w$]+\s*\}/g, '');
+        if (/[@{}]/.test(stripped)) {
+          bad.push(`${locale}: ${key}`);
+        }
+      }
+    }
+    expect(bad).toEqual([]);
+  });
+
+  it('renders every message without errors', () => {
+    for (const locale of SUPPORTED_LOCALES) {
+      for (const key of Object.keys(flat[locale] ?? {})) {
+        const result = i18n.global.t(key, {}, { locale });
+        expect(typeof result).toBe('string');
+      }
+    }
+  });
+});
+
+describe('i18n keys used in the source code', () => {
+  it('only uses keys that exist', () => {
+    // t('a.b'), $t('a.b'), te('a.b'), i18n.global.t('a.b'), keypath="a.b"
+    const keyPattern = '([A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)+)';
+    const callRe = new RegExp(`(?<![\\w$])\\$?te?\\(\\s*(['"\`])${keyPattern}\\1`, 'g');
+    const keypathRe = new RegExp(`keypath="${keyPattern}"`, 'g');
+    const missing: string[] = [];
+    let usedKeys = 0;
+    for (const [file, content] of Object.entries(sourceFiles)) {
+      if (file.endsWith('.d.ts')) {
+        continue;
+      }
+      const used = [
+        ...[...content.matchAll(callRe)].map((m) => m[2]),
+        ...[...content.matchAll(keypathRe)].map((m) => m[1]),
+      ];
+      for (const key of used) {
+        usedKeys += 1;
+        if (key && reference[key] === undefined) {
+          missing.push(`${file}: ${key}`);
+        }
+      }
+    }
+    // Sanity check - the source scan must find the keys used by the app shell.
+    expect(usedKeys).toBeGreaterThan(10);
+    expect(missing).toEqual([]);
+  });
+});
+
+describe('i18n helpers', () => {
+  it('te() also finds keys that only exist in the fallback locale', () => {
+    // The dynamic-key display helpers (te(key) ? t(key) : value) rely on this behaviour.
+    const previous = getLocale();
+    i18n.global.mergeLocaleMessage(FALLBACK_LOCALE, { zzTest: { onlyInEn: 'only in en' } });
+    try {
+      setLocale('zh-CN');
+      expect(te('zzTest.onlyInEn')).toBe(true);
+      expect(t('zzTest.onlyInEn')).toBe('only in en');
+      expect(te('zzTest.onlyInEn', 'zh-CN')).toBe(false);
+      expect(te('zzTest.doesNotExist')).toBe(false);
+      expect(te('common.actions.yes')).toBe(true);
+    } finally {
+      setLocale(previous);
+    }
+  });
+
+  it('formatTimedelta() localizes Python timedelta strings for display', () => {
+    const previous = getLocale();
+    try {
+      setLocale('en');
+      expect(formatTimedelta('1 day, 2:00:00')).toBe('1 day, 2:00:00');
+      expect(formatTimedelta('2 days, 01:00:00')).toBe('2 days, 01:00:00');
+      expect(formatTimedelta('0:30:00')).toBe('0:30:00');
+      setLocale('zh-CN');
+      expect(formatTimedelta('1 day, 2:00:00')).toBe('1天 2:00:00');
+      expect(formatTimedelta('12 days, 3:04:05')).toBe('12天 3:04:05');
+      expect(formatTimedelta('-1 day, 23:00:00')).toBe('-1天 23:00:00');
+      expect(formatTimedelta('0:30:00')).toBe('0:30:00');
+      expect(formatTimedelta(undefined)).toBeUndefined();
+      expect(formatTimedelta(null)).toBeUndefined();
+    } finally {
+      setLocale(previous);
+    }
+  });
+});
