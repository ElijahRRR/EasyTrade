{
    // ============================================================
    // 第一阶段：OKX USDT 永续合约回测配置
    // 用法：freqtrade backtesting --config configs/config.okx-backtest.json --strategy <策略名>
    //
    // 为什么用 OKX：美国 VPS 访问币安/Bybit 会被拒（HTTP 451/403），OKX 的公开行情可以访问。
    // 注意：OKX 的 mark 价格和资金费率历史只有最近约 3 个月，更早的资金费按 0 近似；
    //       上实盘前必须在允许访问币安的地区，用币安数据重新回测确认（见 README）。
    // ============================================================
    "$schema": "https://schema.freqtrade.io/schema.json",
    "add_config_files": [
        "config.base.json",
        "pairs.okx-usdt-perp.json"
    ],

    "dry_run": true,
    "dry_run_wallet": 1000,
    "max_open_trades": 4,

    "exchange": {
        // 如果是在 my.okx.com（OKX EEA）注册的账户，要改成 "myokx"。回测只用公开行情，无需 API Key。
        "name": "okx",
        "key": "",
        "secret": "",
        "password": "",
        "ccxt_config": {},
        "ccxt_async_config": {}
    },

    "pairlists": [
        { "method": "StaticPairList" }
    ],

    // OKX 只能下载最近约 3 个月的资金费率/mark 数据。
    // 设成 0 = 缺数据的时间段按"资金费为 0"计算（交易所有数据的时间段仍用真实费率）。
    // 这会让 3 个月以前的回测结果略偏乐观/偏悲观，属于已知近似。
    "futures_funding_rate": 0
}
