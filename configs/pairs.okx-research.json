        "pair_blacklist": [
            // 稳定币、黄金币：没有正常的波动，或者跟加密行情无关
            // （OKX 永续没有杠杆代币，不用写；也别写 ".*UP/.*" 这种规则，会误伤 JUP 这类正常币）
            "(USDC|FDUSD|TUSD|DAI|USDE|USDD|PYUSD|USTC|BUSD)/.*",
