{
    // ============================================================
    // XSMomentum 在策略研究里的额外设置（配置片段，不单独使用）。
    // scripts/research.sh 回测 / 调参 XSMomentum 时，自动把本文件叠加在 config.okx-research.json 后面，只对这个策略生效。
    //
    // 为什么：XSMomentum 默认多空各 3 笔（top_k = 3），要 6 个仓位名额。研究配置是 5 个，
    //   不加这个文件的话，策略会自动降成多空各 2 笔（日志里有警告），测的就不是默认的策略了。
    // 实盘时它单独一个机器人、一个子账户（docs/strategies-round3.md 第 3 节），那个机器人的配置里也要写 "max_open_trades": 6。
    // 其他策略想要自己的设置，照这个样子建 configs/research-overrides/<策略类名>.json 即可。
    // ============================================================
    "max_open_trades": 6
}
