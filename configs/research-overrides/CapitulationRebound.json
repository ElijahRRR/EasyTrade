{
    // ============================================================
    // CapitulationRebound 在策略研究里的额外设置（配置片段，不单独使用）。
    // scripts/research.sh 回测 CapitulationRebound 时，自动把本文件叠加在研究配置后面，只对这个策略生效。
    //
    // 为什么：第 5 轮预注册规格（docs/round5-preregistration.md 第 2.3 节）写明 max_open_trades 为 6
    //   （同一天最多取 5 个信号，之后还受组合热度 6% 和 max_open_trades 6 的限制）。研究配置默认是 5 个，
    //   不加这个文件的话，测的就不是登记过的那个规格。
    // 实盘时它单独一个机器人、一个子账户，那个机器人的配置里也要写 "max_open_trades": 6。
    // ============================================================
    "max_open_trades": 6
}
