{
    // ============================================================
    // XSFundingCarry 在策略研究里的额外设置（配置片段，不单独使用）。
    // scripts/research.sh 回测 XSFundingCarry 时，自动把本文件叠加在研究配置
    // （configs/config.binance-research.json）后面，只对这个策略生效。
    //
    // 为什么：币池最多 30 个币，三分位 n = floor(30 / 3) = 10，多空各 10 条腿，一共要 20 个仓位名额；
    //   研究配置只有 5 个，不加这个文件的话 freqtrade 只开得出前 5 条腿，测的就不是预注册的策略了。
    //   热度上限 8% 写在策略的类属性里（max_portfolio_risk = 0.08），不在这里。
    // 实盘时它单独一个机器人、一个子账户，那个机器人的配置里也要写 "max_open_trades": 20。
    // ============================================================
    "max_open_trades": 20
}
