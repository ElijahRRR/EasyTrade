# ---------- 密钥 / 私有配置（绝对不能提交） ----------
.env
.env.*
!.env.example
*.private.json
config.private.json
configs/*.private.json
*.pem
*.key

# ---------- freqtrade 运行产物 ----------
user_data/data/
user_data/backtest_results/*
!user_data/backtest_results/.gitkeep
user_data/hyperopt_results/*
!user_data/hyperopt_results/.gitkeep
user_data/logs/*
!user_data/logs/.gitkeep
user_data/plot/*
!user_data/plot/.gitkeep
user_data/notebooks/*
!user_data/notebooks/.gitkeep
user_data/freqaimodels/
# 第 2 步策略研究（scripts/research.sh）的结果目录，和 hyperopt 的锁文件
user_data/research/
user_data/hyperopt.lock
# 第 4 轮币安模拟盘（scripts/run_dryrun.sh）：数据库、日志、看门狗状态、冻结的策略代码副本（含 NFI，GPL-3.0）；
# 以前几轮留档的目录（user_data/dryrun.round-<日期>/，见 docs/forward-test.md 第 12 节）
user_data/dryrun/
user_data/dryrun.*/
user_data/*.sqlite
user_data/*.sqlite-*
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.log

# 策略的 hyperopt 参数文件可以提交（与策略同名的 .json），不要忽略 user_data/strategies/
# 例外：第三方基准策略（scripts/fetch_benchmarks.sh 下载的固定版本，GPL-3.0，不进 git；见 docs/benchmarks.md）
user_data/strategies/vendor/
user_data/strategies/.vendor-download.*/
# NFI 运行/回测时在 user_data/ 下写的缓存文件（止盈目标、手动"持有"设置）
user_data/nfi*-profit_max-*.json
user_data/nfi-hold-trades.json

# ---------- Python ----------
.venv
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---------- 编辑器 / 系统 ----------
.DS_Store
.idea/
.vscode/
*.swp

# ---------- FreqUI 中文版构建产物（frequi-zh/build.sh 生成，可随时重新构建） ----------
frequi-zh/dist/
frequi-zh/.build/
